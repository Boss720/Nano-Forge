{
  "name": "@nanoforge/llm-router",
  "version": "0.1.0",
  "description": "Provider-independent LLM router, normalized provider adapters, model registry, capability-floor scoring, and compact handoffs for NanoForge",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./providers/*": {
      "types": "./src/providers/*.ts",
      "import": "./src/providers/*.ts",
      "default": "./src/providers/*.ts"
    },
    "./registry/*": {
      "types": "./src/registry/*.ts",
      "import": "./src/registry/*.ts",
      "default": "./src/registry/*.ts"
    },
    "./routing/*": {
      "types": "./src/routing/*.ts",
      "import": "./src/routing/*.ts",
      "default": "./src/routing/*.ts"
    },
    "./context/*": {
      "types": "./src/context/*.ts",
      "import": "./src/context/*.ts",
      "default": "./src/context/*.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@nanoforge/protocol": "workspace:*",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  }
}
